;; -*- lexical-binding: t; -*-

(use-package markdown-ts-appear
  :ensure t
  :pin nongnu
  :hook (markdown-mode . markdown-ts-appear-mode)
  :hook (markdown-ts-mode . markdown-ts-appear-mode)
  :config
  (defun my-diagram-cli-render (command-fn _lang code theme cb)
    "Render CODE via process generated by COMMAND-FN, invoking CB with SVG string."
    (let* ((out-buf (generate-new-buffer " *diagram-svg*"))
           (err-buf (generate-new-buffer " *diagram-err*"))
           (proc (make-process
                  :name "markdown-diagram-render"
                  :buffer out-buf
                  :stderr err-buf
                  :noquery t
                  :connection-type 'pipe
                  :coding 'utf-8-unix
                  :command (funcall command-fn theme)
                  :sentinel
                  (lambda (p _ev)
                    (when (memq (process-status p) '(exit signal))
                      (unwind-protect
                          (if (zerop (process-exit-status p))
                              (funcall cb (with-current-buffer out-buf (buffer-string)) nil)
                            (funcall cb nil (with-current-buffer err-buf (string-trim (buffer-string)))))
                        (kill-buffer out-buf)
                        (kill-buffer err-buf)))))))
      (process-send-string proc code)
      (process-send-eof proc)
      (lambda () (when (process-live-p proc) (interrupt-process proc)))))

  (defun my-render-mmdr (lang code theme cb)
    "Render Mermaid diagram using mmdr with transparent background styling."
    (let ((cfg (make-temp-file "mmdr-" nil ".json"
                               (format "{\"theme\":\"%s\",\"themeVariables\":{\"background\":\"transparent\"}}"
                                       (if (string= theme "dark") "dark" "default")))))
      (let ((cancel (my-diagram-cli-render
                     (lambda (_theme) (list "mmdr" "-i" "-" "-c" cfg))
                     lang code theme
                     (lambda (svg err)
                       (when (file-exists-p cfg) (delete-file cfg))
                       (funcall cb svg err)))))
        (lambda ()
          (when (file-exists-p cfg) (delete-file cfg))
          (funcall cancel)))))

  (with-eval-after-load 'markdown-ts-appear-diagram
    (setq markdown-ts-appear-diagram-size 'window)
    (setopt markdown-ts-appear-diagram-renderers
            `(("mermaid" . ,#'my-render-mmdr)))))

(provide 'setup-markdown-ts-appear)
